# Optional satellite / cloud tile providers (browser-visible, domain-restrict them)
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_OPENWEATHERMAP_API_KEY=

# Optional keyed data providers (server-only)
WINDY_WEBCAMS_API_KEY=
AISSTREAM_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Secure server-side AISStream relay. Never expose an AISStream key in the browser.
AIS_SHIP_RELAY_URL=
AIS_SHIP_RELAY_TOKEN=
